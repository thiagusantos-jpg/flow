{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "adminUsers": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "root.child('adminUsers').child(auth.uid).child('role').val() === 'admin' || $uid === auth.uid"
      }
    },
    ".read": false,
    ".write": false
  }
}
